{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Hub",
  "version": "0.1.14",
  "identifier": "cn.workbuddy.hub",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy Hub",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0b0d13",
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
